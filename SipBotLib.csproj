<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SipBotLib</PackageId>
    <Version>0.1.6</Version>
    <Authors>Caleb Taylor</Authors>
    <Description>Headless SIP/PBX library for coding agents: register, answer, dial, transfer, DTMF, play, and record. No GUI softphone.</Description>
    <RepositoryUrl>https://github.com/calebtt/SipBotLib</RepositoryUrl>
    <PackageProjectUrl>https://github.com/calebtt/SipBotLib</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>sip;pbx;voip;sipsorcery;agent</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SipBotLib.Tests" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.11" />
    <PackageReference Include="SIPSorcery" Version="10.0.11" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
  </ItemGroup>

  <!-- Local test harnesses live under tools/ and must not compile into the library. -->
  <ItemGroup>
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
  </ItemGroup>
</Project>
